{
  "name": "echo",
  "version": "0.1.0",
  "private": true,
  "description": "Echo — a personalized memory MCP server with a 3D brain dashboard and gesture-controlled recall.",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:dashboard": "npm --prefix dashboard run dev",
    "build:server": "npm --prefix server run build",
    "build:dashboard": "npm --prefix dashboard run build",
    "install:all": "npm --prefix server install && npm --prefix dashboard install"
  },
  "keywords": [
    "mcp",
    "memory",
    "claude",
    "model-context-protocol",
    "personalization",
    "gesture-control",
    "three.js"
  ],
